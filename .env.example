# Copy to .env for local overrides. Never commit .env.
POSTGRES_USER=dlp
POSTGRES_PASSWORD=dlp
POSTGRES_DB=dlp
APP_DB_PASSWORD=dlp_app
JWT_SECRET=dev-only-jwt-secret-change-me
SCAN_HMAC_SECRET=dev-only-hmac-secret-change-me
SCAN_DELAY_SECONDS=2
S3_BUCKET=dlp-transfers
SQS_QUEUE_NAME=dlp-scan
AWS_REGION=ap-southeast-2
# Local stand-ins (moto). Empty in AWS: real S3/SQS via Pod Identity.
AWS_ENDPOINT_URL=http://localhost:5000
S3_PUBLIC_ENDPOINT_URL=http://localhost:5000
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
